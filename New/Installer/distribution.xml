<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Transit USB</title>
  <welcome file="welcome.html" mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>
  <options customize="always" require-scripts="false" hostArchitectures="arm64,x86_64"/>
  <allowed-os-versions><os-version min="13.0"/></allowed-os-versions>
  <domains enable_localSystem="true" enable_anywhere="false" enable_currentUserHome="false"/>
  <choices-outline><line choice="install"/><line choice="uninstall"/></choices-outline>
  <choice id="install" title="INSTALL_TITLE" description="INSTALL_DESC" start_selected="true" selected="!choices.uninstall.selected">
    <pkg-ref id="com.local.transit-usb.pkg"/>
  </choice>
  <choice id="uninstall" title="UNINSTALL_TITLE" description="UNINSTALL_DESC" start_selected="false" selected="!choices.install.selected">
    <pkg-ref id="com.local.transit-usb.uninstall"/>
  </choice>
  <pkg-ref id="com.local.transit-usb.pkg" version="2.0" onConclusion="none">TransitUSB-component.pkg</pkg-ref>
  <pkg-ref id="com.local.transit-usb.uninstall" version="2.0" onConclusion="none">TransitUSB-uninstall.pkg</pkg-ref>
</installer-gui-script>
